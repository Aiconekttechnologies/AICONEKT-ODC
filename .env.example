# Server Port (Default: 3000)
PORT=3000

# Public Browser Supabase Configuration (Safe for Vite Client Bundle)
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Trusted Server-Only Supabase Admin Configuration (NEVER prefix with VITE_)
# Used exclusively by server/routes/adminAccess.ts to dispatch Supabase Auth email invites
# and enrich auth.users registration metadata for the CEO.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional One-Time Server Secret for POST /api/admin/bootstrap-ceo (Server-Only)
CEO_BOOTSTRAP_SECRET=